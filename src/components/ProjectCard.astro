---
const {
  title,
  teaser,
  titleKey,
  teaserKey,
  year,
  tags = [],
  href,
  image,
} = Astro.props as {
  title: string;
  teaser?: string;
  titleKey?: string;
  teaserKey?: string;
  year?: number;
  tags?: string[];
  href: string;
  image?: string;
};
const isExternal = href.startsWith('http');
const previewUrl = image || (isExternal ? `https://s.wordpress.com/mshots/v1/${encodeURIComponent(href)}?w=800&h=450` : undefined);
---

<a
  href={href}
  class="glass glass-specular card-hover group block overflow-hidden !p-0"
  target={isExternal ? '_blank' : undefined}
  rel={isExternal ? 'noopener noreferrer' : undefined}
>
  {
    previewUrl && (
      <div class="relative aspect-video w-full overflow-hidden">
        <img
          src={previewUrl}
          alt={title}
          class="h-full w-full object-cover transition-transform duration-500 ease-apple group-hover:scale-105"
          loading="lazy"
        />
        <div
          class="pointer-events-none absolute inset-x-0 bottom-0 h-1/3 bg-gradient-to-t from-black/20 to-transparent dark:from-black/40"
          aria-hidden="true"
        >
        </div>
      </div>
    )
  }
  <div class="p-5">
    <div class="flex items-start justify-between gap-4">
      <div class="min-w-0">
        <h3 class="truncate text-lg font-semibold tracking-tight transition-colors duration-300 group-hover:text-brand">
          {titleKey ? (
            <span data-i18n-title={titleKey}>{title}</span>
          ) : (
            title
          )}
        </h3>
        {
          (teaser || teaserKey) && (
            <p class="mt-2 line-clamp-2 text-sm text-neutral-700 dark:text-neutral-200">
              {teaserKey ? (
                <span data-i18n-teaser={teaserKey}>{teaser}</span>
              ) : (
                teaser
              )}
            </p>
          )
        }
        {
          tags.length > 0 && (
            <ul class="mt-4 flex flex-wrap gap-2 text-[10px] font-semibold uppercase tracking-wider text-neutral-500 dark:text-neutral-400">
              {tags.map((t) => (
                <li class="rounded-full border border-neutral-900/15 bg-white/80 px-2.5 py-0.5 text-neutral-700 backdrop-blur-sm dark:border-white/20 dark:bg-white/10 dark:text-neutral-200">
                  {t}
                </li>
              ))}
            </ul>
          )
        }
      </div>
      {
        typeof year === 'number' && (
          <span class="shrink-0 text-sm text-neutral-400">{year}</span>
        )
      }
    </div>
  </div>
</a>
