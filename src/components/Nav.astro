---
const links = [
  { href: '/', label: 'Home' },
];
import ThemeToggle from './ThemeToggle.astro';
import LangToggle from './LangToggle.astro';
---

<nav
  class="glass-subtle sticky top-0 z-50 border-b border-white/10 transition-all duration-500 ease-apple data-[compact=true]:py-0 dark:border-white/5"
>
  <div
    class="container relative flex h-14 items-center transition-all duration-500 ease-apple"
    data-nav-inner
  >
    <a id="nav-logo-link" href="/" class="inline-flex items-center gap-2" aria-label="Inicio">
      <img
        src="/logo.png"
        alt="Martin Ruiz"
        width="120"
        height="24"
        class="h-12 w-auto block transition-all duration-500 ease-apple data-[compact=true]:h-8 dark:hidden"
      />
      <img
        src="/logo-dark.png"
        alt="Martin Ruiz"
        width="120"
        height="24"
        class="h-12 w-auto hidden transition-all duration-500 ease-apple data-[compact=true]:h-8 dark:block"
      />
    </a>
    <div
      class="flex-1 flex justify-center items-center gap-4 transition-all duration-500 ease-apple data-[compact=true]:gap-3"
    >
      <div
        data-pills
        class="relative rounded-full border border-white/20 bg-white/30 p-1 backdrop-blur-sm transition-all duration-500 ease-apple dark:border-white/10 dark:bg-white/10 data-[compact=true]:scale-90 data-[compact=true]:p-0.5"
      >
        <div
          class="flex items-center gap-1 transition-all duration-500 ease-apple data-[compact=true]:gap-0.5"
        >
          {
            links.map((l) => {
              const currentPath = Astro.url.pathname;
              const active =
                l.href === '/'
                  ? currentPath === '/'
                  : currentPath.startsWith(l.href);
              return (
                <a
                  href={l.href}
                  aria-current={active ? 'page' : undefined}
                  aria-label={l.label}
                  class={[
                    'inline-flex items-center h-9 rounded-full px-3 transition-all duration-300 ease-apple data-[compact=true]:h-8 data-[compact=true]:text-xs',
                    active
                      ? 'bg-white/80 text-neutral-900 shadow-sm backdrop-blur-sm dark:bg-white/15 dark:text-white data-[compact=true]:px-2.5'
                      : 'text-neutral-600 hover:bg-white/40 hover:text-neutral-900 dark:text-neutral-400 dark:hover:bg-white/10 dark:hover:text-neutral-100 data-[compact=true]:p-2',
                  ].join(' ')}
                >
                  {l.label === 'Home' ? (
                    <svg
                      width="18"
                      height="18"
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                      class="shrink-0 transition-all duration-300 ease-apple data-[compact=true]:scale-90"
                      fill="currentColor"
                    >
                      <path d="M12 3.172 3 10v10a1 1 0 0 0 1 1h6v-6h4v6h6a1 1 0 0 0 1-1V10l-9-6.828z" />
                    </svg>
                  ) : (
                    <svg
                      width="18"
                      height="18"
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                      class="shrink-0 transition-all duration-300 ease-apple data-[compact=true]:scale-90"
                      fill="currentColor"
                    >
                      <path d="M4 5a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v10a2 2 0 0 1-2 2H9l-5 4v-4a2 2 0 0 1-2-2V5z" />
                    </svg>
                  )}
                  <span
                    aria-hidden="true"
                    class={[
                      'overflow-hidden text-sm transition-all duration-300 ease-apple',
                      active
                        ? 'ml-1.5 max-w-[160px] opacity-100'
                        : 'ml-0 max-w-0 opacity-0',
                    ].join(' ')}
                  >
                    {l.label}
                  </span>
                </a>
              );
            })
          }
        </div>
      </div>
    </div>
    <div
      class="ml-auto flex items-center gap-2 transition-all duration-500 ease-apple data-[compact=true]:scale-90"
      data-actions
    >
      <LangToggle />
      <ThemeToggle />
    </div>

    <script>
      // @ts-nocheck
      const t = () => (typeof window !== 'undefined' && window.__t__ ? window.__t__ : (k) => k);

      const updateNavLabels = () => {
        const fn = t();
        const logo = document.getElementById('nav-logo-link');
        if (logo) logo.setAttribute('aria-label', fn('nav.home'));
        const links = document.querySelectorAll('nav a[aria-label]');
        links.forEach((a) => {
          const href = a.getAttribute('href');
          const key =
            href === '/'
              ? 'nav.home'
              : '';
          if (!key) return;
          a.setAttribute('aria-label', fn(key));
          const span = a.querySelector('span[aria-hidden]');
          if (span) span.textContent = fn(key);
        });
      };

      updateNavLabels();
      window.addEventListener('lang-change', updateNavLabels);
      const nav = document.querySelector('nav');
      const inner = document.querySelector('[data-nav-inner]');
      const actions = document.querySelector('[data-actions]');
      const pills = document.querySelector('[data-pills]');
      const applyCompact = () => {
        const compact = window.scrollY > 8;
        if (nav) nav.setAttribute('data-compact', String(compact));
        if (inner) inner.setAttribute('data-compact', String(compact));
        if (actions) actions.setAttribute('data-compact', String(compact));
        if (pills) pills.setAttribute('data-compact', String(compact));
        document
          .querySelectorAll('nav a[aria-label]')
          .forEach((a) => a.setAttribute('data-compact', String(compact)));
      };
      applyCompact();
      window.addEventListener('scroll', applyCompact, { passive: true });
      window.addEventListener('resize', applyCompact);
      const main = document.querySelector('main');
      if (main) {
        main.classList.add('page-enter');
        setTimeout(() => main.classList.remove('page-enter'), 500);
      }
      document.querySelectorAll('a[href^="/"]').forEach((a) => {
        a.addEventListener('click', (e) => {
          const url = new URL(a.href, location.origin);
          if (url.origin !== location.origin) return;
          if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
          if (!main) return;
          e.preventDefault();
          main.classList.add('page-exit');
          setTimeout(() => {
            window.location.href = a.href;
          }, 380);
        });
      });
    </script>
  </div>
</nav>
