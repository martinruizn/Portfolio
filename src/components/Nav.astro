---
const links = [
  { href: '/', hash: '', key: 'nav.home', label: 'Inicio', icon: 'home' },
  { href: '/#about', hash: '#about', key: 'nav.about', label: 'Sobre mí', icon: 'about' },
  { href: '/#speaking', hash: '#speaking', key: 'nav.speaking', label: 'Speaker', icon: 'speaking' },
  { href: '/#projects', hash: '#projects', key: 'nav.projects', label: 'Proyectos', icon: 'projects' },
];
import ThemeToggle from './ThemeToggle.astro';
import LangToggle from './LangToggle.astro';
---

<nav
  class="glass-subtle sticky top-0 z-50 border-b border-neutral-900/10 transition-all duration-500 ease-apple data-[compact=true]:py-0 dark:border-white/10"
>
  <div
    class="container relative flex h-14 items-center transition-all duration-500 ease-apple"
    data-nav-inner
  >
    <a id="nav-logo-link" href="/" class="inline-flex shrink-0 items-center gap-2" aria-label="Inicio">
      <img
        src="/logo.png"
        alt="Martin Ruiz"
        width="120"
        height="24"
        class="h-8 w-auto block transition-all duration-500 ease-apple sm:h-12 data-[compact=true]:h-8 dark:hidden"
      />
      <img
        src="/logo-dark.png"
        alt="Martin Ruiz"
        width="120"
        height="24"
        class="h-8 w-auto hidden transition-all duration-500 ease-apple sm:h-12 data-[compact=true]:h-8 dark:block"
      />
    </a>
    <div
      class="flex-1 flex justify-center items-center gap-4 min-w-0 px-2 transition-all duration-500 ease-apple data-[compact=true]:gap-3"
    >
      <div
        data-pills
        class="relative max-w-full overflow-x-auto rounded-full border border-neutral-900/10 bg-white/50 p-0.5 backdrop-blur-sm transition-all duration-500 ease-apple [scrollbar-width:none] dark:border-white/15 dark:bg-white/10 sm:p-1 data-[compact=true]:scale-90 data-[compact=true]:p-0.5 [-ms-overflow-style:none] [&::-webkit-scrollbar]:hidden"
      >
        <div
          class="flex items-center gap-1 transition-all duration-500 ease-apple data-[compact=true]:gap-0.5"
        >
          {
            links.map((l) => {
              const currentPath = Astro.url.pathname;
              const active = l.href === '/' ? currentPath === '/' && !Astro.url.hash : false;
              return (
                <a
                  href={l.href}
                  data-nav-key={l.key}
                  aria-current={active ? 'page' : undefined}
                  aria-label={l.label}
                  class={[
                    'inline-flex items-center h-8 rounded-full px-2 text-xs transition-all duration-300 ease-apple sm:h-9 sm:px-3 sm:text-sm data-[compact=true]:h-8 data-[compact=true]:text-xs whitespace-nowrap',
                    active
                      ? 'bg-white text-neutral-900 shadow-sm backdrop-blur-sm dark:bg-white/20 dark:text-white data-[compact=true]:px-2.5'
                      : 'text-neutral-700 hover:bg-white/70 hover:text-neutral-900 dark:text-neutral-200 dark:hover:bg-white/15 dark:hover:text-white data-[compact=true]:p-2',
                  ].join(' ')}
                >
                  {l.icon === 'home' ? (
                    <svg
                      width="16"
                      height="16"
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                      class="shrink-0 transition-all duration-300 ease-apple data-[compact=true]:scale-90"
                      fill="currentColor"
                    >
                      <path d="M12 3.172 3 10v10a1 1 0 0 0 1 1h6v-6h4v6h6a1 1 0 0 0 1-1V10l-9-6.828z" />
                    </svg>
                  ) : null}
                  <span
                    aria-hidden="true"
                    class:list={[
                      'text-sm transition-all duration-300 ease-apple',
                      l.icon === 'home' ? 'ml-1.5 hidden sm:inline' : 'ml-0',
                    ]}
                  >
                    {l.label}
                  </span>
                </a>
              );
            })
          }
        </div>
      </div>
    </div>
    <div
      class="ml-auto flex shrink-0 items-center gap-2 transition-all duration-500 ease-apple data-[compact=true]:scale-90"
      data-actions
    >
      <LangToggle />
      <ThemeToggle />
    </div>

    <script>
      // @ts-nocheck
      const t = () => (typeof window !== 'undefined' && window.__t__ ? window.__t__ : (k) => k);

      const updateNavLabels = () => {
        const fn = t();
        const logo = document.getElementById('nav-logo-link');
        if (logo) logo.setAttribute('aria-label', fn('nav.home'));
        document.querySelectorAll('nav a[data-nav-key]').forEach((a) => {
          const key = a.getAttribute('data-nav-key');
          if (!key) return;
          a.setAttribute('aria-label', fn(key));
          const span = a.querySelector('span[aria-hidden]');
          if (span) span.textContent = fn(key);
        });
      };

      const setActiveFromHash = () => {
        const hash = window.location.hash || '';
        document.querySelectorAll('nav a[data-nav-key]').forEach((a) => {
          const href = a.getAttribute('href') || '';
          const isHome = href === '/';
          const active = isHome ? hash === '' : href.endsWith(hash) && hash !== '';
          if (active) {
            a.setAttribute('aria-current', 'page');
            a.classList.add(
              'bg-white',
              'text-neutral-900',
              'shadow-sm',
              'dark:bg-white/20',
              'dark:text-white'
            );
            a.classList.remove('text-neutral-700', 'dark:text-neutral-200');
          } else {
            a.removeAttribute('aria-current');
            a.classList.remove(
              'bg-white',
              'text-neutral-900',
              'shadow-sm',
              'dark:bg-white/20',
              'dark:text-white'
            );
            a.classList.add('text-neutral-700', 'dark:text-neutral-200');
          }
        });
      };

      updateNavLabels();
      setActiveFromHash();
      window.addEventListener('lang-change', updateNavLabels);
      window.addEventListener('hashchange', setActiveFromHash);
      const nav = document.querySelector('nav');
      const inner = document.querySelector('[data-nav-inner]');
      const actions = document.querySelector('[data-actions]');
      const pills = document.querySelector('[data-pills]');
      const applyCompact = () => {
        const compact = window.scrollY > 8;
        if (nav) nav.setAttribute('data-compact', String(compact));
        if (inner) inner.setAttribute('data-compact', String(compact));
        if (actions) actions.setAttribute('data-compact', String(compact));
        if (pills) pills.setAttribute('data-compact', String(compact));
        document
          .querySelectorAll('nav a[aria-label]')
          .forEach((a) => a.setAttribute('data-compact', String(compact)));
      };
      applyCompact();
      window.addEventListener('scroll', applyCompact, { passive: true });
      window.addEventListener('resize', applyCompact);
      const main = document.querySelector('main');
      if (main) {
        main.classList.add('page-enter');
        setTimeout(() => main.classList.remove('page-enter'), 500);
      }
      document.querySelectorAll('a[href^="/"]').forEach((a) => {
        a.addEventListener('click', (e) => {
          const url = new URL(a.href, location.origin);
          if (url.origin !== location.origin) return;
          if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
          if (url.pathname === location.pathname && url.hash) {
            setTimeout(setActiveFromHash, 0);
            return;
          }
          if (!main) return;
          e.preventDefault();
          main.classList.add('page-exit');
          setTimeout(() => {
            window.location.href = a.href;
          }, 380);
        });
      });
    </script>
  </div>
</nav>
