---
import Nav from '../components/Nav.astro';
import '../styles/global.css';
import {
  type Lang,
  absoluteUrl,
  localeCanonicalPath,
  localeMeta,
  useTranslations,
} from '../i18n';
import { buildJsonLd } from '../lib/jsonld';

const { lang = 'es' } = Astro.props as { lang?: Lang };

const t = useTranslations(lang);
const site = Astro.site ?? new URL('https://martinruiz.dev');
const canonical = absoluteUrl(localeCanonicalPath(lang), site.href);
const alternateEs = absoluteUrl(localeCanonicalPath('es'), site.href);
const alternateEn = absoluteUrl(localeCanonicalPath('en'), site.href);
const title = t('meta.homeTitle');
const description = t('meta.homeDescription');
const ogImage = absoluteUrl('/og-default.jpg', site.href);
const ogLocale = localeMeta[lang].og;
const ogLocaleAlternate = localeMeta[lang].ogAlternate;
const jsonLd = buildJsonLd({ lang, site: site.href });
---

<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content="index, follow" />
    <meta name="author" content="Martin Ruiz" />
    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es" href={alternateEs} />
    <link rel="alternate" hreflang="en" href={alternateEn} />
    <link rel="alternate" hreflang="x-default" href={alternateEs} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Martin Ruiz" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={ogLocaleAlternate} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:alt" content={title} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={title} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <div class="bg-depth" aria-hidden="true">
      <div class="bg-depth-orb bg-depth-orb--1"></div>
      <div class="bg-depth-orb bg-depth-orb--2"></div>
      <div class="bg-depth-orb bg-depth-orb--3"></div>
    </div>
    <Nav lang={lang} />
    <main class="container py-10">
      <slot />
    </main>
  </body>
</html>
