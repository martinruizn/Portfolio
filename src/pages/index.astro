---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import SpeakingCarousel from '../components/SpeakingCarousel.astro';

const projects = [
  {
    title: 'Menorca luxury padel retreat',
    teaser: 'Landing premium para el retiro de pádel de lujo en Menorca. Coaching elite, alojamiento 5 estrellas, gastronomía y experiencias mediterráneas all-inclusive.',
    titleKey: 'projects.menorcaTitle',
    teaserKey: 'projects.menorcaTeaser',
    href: 'https://menorca.cspadel.com/',
    tags: ['Astro 6', 'React 19', 'TypeScript', 'Tailwind CSS 4', 'Vite 7', 'i18next', 'Framer Motion', 'Vercel']
  },
  {
    title: 'MarketLab',
    teaser: 'Aplicación full-stack de mercados de predicción Yes/No con dinero ficticio. Compra shares, sigue posiciones y explora mercados simulados.',
    titleKey: 'projects.marketLabTitle',
    teaserKey: 'projects.marketLabTeaser',
    href: 'https://marketlab-pied-pi.vercel.app',
    tags: ['Next.js 16', 'React 19', 'TypeScript', 'Tailwind CSS 4', 'shadcn/ui', 'Supabase', 'Zod', 'Bun']
  },
  {
    title: 'Kuyuriy Adolescentes',
    teaser: 'Flujo de inscripción a un evento: Landing + form de inscripción + vinculación con pasarela de pagos (Payphone) + emisión automática de facturación (Dora - Contifico).',
    titleKey: 'projects.kuyuriyAdolescentesTitle',
    teaserKey: 'projects.kuyuriyAdolescentesTeaser',
    href: 'https://adolescentes.kuyuriy.com',
    tags: ['Astro 4.0', 'Vercel', 'Node.js', 'TypeScript', 'Jotform', 'Google Analytics', 'Brevo', 'API Payphone', 'API Dora']
  },
  {
    title: 'Kuyuriy Centro',
    teaser: 'Centro de psicopedagogía y psicología. Sitio web institucional con integración de formularios y analíticas.',
    titleKey: 'projects.kuyuriyCentroTitle',
    teaserKey: 'projects.kuyuriyCentroTeaser',
    href: 'https://kuyuriy.com',
    tags: ['WordPress', 'Divi', 'Jotform', 'Analytics']
  },
  {
    title: 'Cs Padel',
    teaser: 'Sitio web principal y Landing de captación de leads para eventos deportivos.',
    titleKey: 'projects.cspadelTitle',
    teaserKey: 'projects.cspadelTeaser',
    href: 'https://miami.cspadel.com',
    tags: ['WordPress', 'Elementor', 'Astro 4.0', 'Jotform', 'Vercel']
  },
  {
    title: 'NatiPsicope',
    teaser: 'Landing page e inscripción a talleres especializados.',
    titleKey: 'projects.natipsicopeTitle',
    teaserKey: 'projects.natipsicopeTeaser',
    href: 'https://funciones-ejecutivas.natipsicope.com',
    tags: ['ReactJS', 'Jotform']
  },
  {
    title: 'AndesVeloCycling',
    teaser: 'Prototipo de plataforma de turismo deportivo, centraliza rutas, gastronomía y hotelería.',
    titleKey: 'projects.andesVeloTitle',
    teaserKey: 'projects.andesVeloTeaser',
    href: 'https://andes-velo-cycling.vercel.app',
    tags: ['ReactJS', 'TypeScript', 'Node.js']
  },
  {
    title: 'Campus AutoSpa',
    teaser: 'Plataforma de pago, agendamiento y seguimiento de negocio de lavado de autos.',
    titleKey: 'projects.campusAutoSpaTitle',
    teaserKey: 'projects.campusAutoSpaTeaser',
    href: 'https://campus-auto-spa.vercel.app',
    tags: ['Astro 4.0', 'ReactJS', 'Supabase', 'Node.js']
  }
];

const experience = [
  { roleKey: 'experience.citusRole', orgKey: 'experience.citusOrg', role: 'Forward Deployed Engineer', org: 'Citus.dev', current: true },
  { roleKey: 'experience.gdgRole', orgKey: 'experience.gdgOrg', role: 'Organizador', org: 'GDG Quito', current: true },
  { roleKey: 'experience.mentaRole', orgKey: 'experience.mentaOrg', role: 'Desarrollador de software', org: 'Menta', current: false },
  { roleKey: 'experience.freelanceRole', orgKey: 'experience.freelanceOrg', role: 'Desarrollador independiente', org: 'Freelance', current: false },
  { roleKey: 'experience.palfarmaRole', orgKey: 'experience.palfarmaOrg', role: 'Gerente de unidad de negocios', org: 'PalFarma', current: false },
];
---

<BaseLayout
  title="Martin Ruiz — Forward Deployed Engineer"
  description="Forward Deployed Engineer en Citus.dev. Producto, flujos con IA y comunidad. Organizador de GDG Quito, basado en Quito, Ecuador."
>
  <section class="pt-10 pb-16">
    <div class="text-center">
      <div
        class="mx-auto mb-6 h-28 w-28 overflow-hidden rounded-full shadow-glass ring-2 ring-neutral-900/10 ring-offset-2 ring-offset-[#dce8e3] dark:ring-white/25 dark:ring-offset-[#121917]"
      >
        <img
          src="/avatar.jpg"
          alt="Foto de Martin Ruiz"
          width="112"
          height="112"
          class="h-full w-full object-cover"
          onerror="this.onerror=null;this.src='/about/workspace.jpg'"
          loading="eager"
        />
      </div>
      <h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">
        Martin Ruiz
      </h1>
      <p
        id="hero-role"
        data-i18n="hero.role"
        class="mt-4 text-lg text-neutral-700 dark:text-neutral-200"
      >
        Forward Deployed Engineer · Citus.dev
      </p>
      <p
        id="hero-tagline"
        data-i18n="hero.tagline"
        class="mt-2 text-sm text-neutral-600 dark:text-neutral-300 sm:text-base"
      >
        Producto, flujos con IA y comunidad · Organizador GDG Quito
      </p>
      <p
        id="hero-location"
        data-i18n="hero.location"
        class="mt-1 text-sm text-neutral-500 dark:text-neutral-400"
      >
        Quito, Ecuador
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <a
          id="cta-github"
          href="https://github.com/martinruizn?tab=repositories"
          class="btn"
          >Ver en GitHub</a
        >
        <a
          id="cta-linkedin-hero"
          href="https://www.linkedin.com/in/martin-ruizn/"
          class="btn-outline"
          >Conectemos en LinkedIn</a
        >
      </div>
    </div>
  </section>

  <section id="about" class="mt-2 scroll-mt-24">
    <div class="glass glass-specular rounded-glassLg p-6 sm:p-10">
      <div class="grid items-start gap-8 md:grid-cols-5">
        <div class="md:col-span-2">
          <div class="overflow-hidden rounded-glass shadow-glass ring-1 ring-neutral-900/10 dark:ring-white/15">
            <img
              src="/about/workspace.jpg"
              alt="Martín Ruiz en su escritorio de trabajo"
              data-i18n-alt="about.photoAlt"
              width="640"
              height="800"
              class="aspect-[4/5] w-full object-cover object-center"
              loading="lazy"
            />
          </div>
        </div>
        <div class="md:col-span-3">
          <div class="prose prose-glass">
            <h2 id="about-section-title" data-i18n="about.sectionTitle">Sobre mí</h2>
            <p id="about-p1" data-i18n="about.p1">
              Mi enfoque une la precisión técnica con una visión comercial humana. Transformo ideas en plataformas digitales iterando y aprendiendo a diario. Más allá del código, gestiono el ciclo de vida de los proyectos para que la tecnología impulse objetivos de negocio e impacto real.
            </p>
            <p id="about-p2" data-i18n="about.p2">
              Pasé casi diez años en el mundo comercial —incluyendo la gerencia de unidad de negocios en PalFarma— hasta que el código se volvió también lo mío. Como desarrollador independiente y después en Menta, construí tecnología para profesionales y clínicas de salud, siendo el puente entre la necesidad del usuario y el equipo de desarrollo. Hoy, como Forward Deployed Engineer en Citus.dev, llevo producto, ingeniería y clientes al mismo tablero.
            </p>
            <p id="about-p3" data-i18n="about.p3">
              También construyo comunidad: soy organizador de GDG Quito, speaker en workshops de Cursor y charlas de e-commerce e IA, y me apasiona compartir lo que funciona cuando se itera en público. People first: productos que la gente realmente usa.
            </p>
          </div>
        </div>
      </div>

      <div class="mt-10">
        <h3
          data-i18n="about.experienceTitle"
          class="text-sm font-semibold uppercase tracking-wider text-neutral-500 dark:text-neutral-400"
        >
          Trayectoria
        </h3>
        <ol
          class="relative mt-6 flex flex-col border-l border-brand/40 pl-6 md:flex-row md:border-l-0 md:border-t md:pl-0"
        >
          {
            experience.map((item) => (
              <li class="relative flex-1 pb-6 last:pb-0 md:min-w-0 md:px-2 md:pb-0 md:pt-7 md:text-center">
                <span
                  class:list={[
                    'absolute h-3 w-3 rounded-full top-1.5 -left-[1.45rem] md:left-1/2 md:top-0 md:-translate-x-1/2 md:-translate-y-1/2',
                    item.current
                      ? 'bg-brand ring-4 ring-brand/20'
                      : 'border-2 border-brand bg-white dark:bg-[#121917]',
                  ]}
                  aria-hidden="true"
                />
                <p class="text-sm font-semibold text-neutral-900 dark:text-neutral-50" data-i18n={item.roleKey}>
                  {item.role}
                </p>
                <p class="mt-0.5 text-sm text-neutral-700 dark:text-neutral-200" data-i18n={item.orgKey}>
                  {item.org}
                </p>
                {item.current && (
                  <span
                    data-i18n="about.current"
                    class="mt-2 inline-block rounded-full bg-brand/15 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wider text-brand dark:bg-white/15 dark:text-white"
                  >
                    Actual
                  </span>
                )}
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <SpeakingCarousel />

  <section id="projects" class="mt-16 scroll-mt-24">
    <h2 id="home-recent" data-i18n="home.recentProjects" class="mb-6 text-xl font-semibold tracking-tight">Proyectos recientes</h2>
    <div class="grid gap-4 sm:grid-cols-2">
      {
        projects.map((p) => (
          <ProjectCard
            title={p.title}
            teaser={p.teaser}
            titleKey={p.titleKey}
            teaserKey={p.teaserKey}
            href={p.href}
            tags={p.tags}
          />
        ))
      }
    </div>
  </section>

  <section class="mt-16">
    <div class="glass glass-specular rounded-glassLg p-8 sm:p-10">
      <div
        class="flex flex-col items-start justify-between gap-6 sm:flex-row sm:items-center"
      >
        <div>
          <h2 id="home-talk-title" data-i18n="home.talkTitle" class="text-xl font-semibold tracking-tight">¿Construimos algo?</h2>
          <p
            id="home-talk-body"
            data-i18n="home.talkBody"
            class="mt-1 text-neutral-700 dark:text-neutral-200"
          >
            Producto, una charla o un espacio de comunidad. Hagámoslo realidad.
          </p>
        </div>
        <div class="flex flex-wrap gap-3">
          <a
            id="cta-write"
            class="btn"
            href="mailto:martinruiz91n@gmail.com">Escríbeme</a
          >
          <a
            id="cta-linkedin"
            class="btn-outline"
            href="https://www.linkedin.com/in/martin-ruizn/"
            >Conectemos en LinkedIn</a
          >
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // @ts-nocheck
  const t = () => (typeof window !== 'undefined' && window.__t__ ? window.__t__ : (k) => k);

  function updateMeta() {
    const fn = t();
    if (document.querySelector('meta[name="description"]'))
      document.querySelector('meta[name="description"]').setAttribute('content', fn('meta.homeDescription'));
    document.title = fn('meta.homeTitle');
  }

  function updateHomeTexts() {
    const fn = t();
    document.querySelectorAll('[data-i18n]').forEach((el) => {
      const key = el.getAttribute('data-i18n');
      if (key) el.textContent = fn(key);
    });
    document.querySelectorAll('[data-i18n-alt]').forEach((el) => {
      const key = el.getAttribute('data-i18n-alt');
      if (key) el.setAttribute('alt', fn(key));
    });
    document.querySelectorAll('[data-i18n-aria]').forEach((el) => {
      const key = el.getAttribute('data-i18n-aria');
      if (key) el.setAttribute('aria-label', fn(key));
    });

    const gh = document.getElementById('cta-github');
    if (gh) gh.textContent = fn('cta.viewGithub');
    const write = document.getElementById('cta-write');
    if (write) write.textContent = fn('cta.writeMe');
    const li = document.getElementById('cta-linkedin');
    if (li) li.textContent = fn('cta.connectLinkedIn');
    const liHero = document.getElementById('cta-linkedin-hero');
    if (liHero) liHero.textContent = fn('cta.connectLinkedIn');

    document.querySelectorAll('[data-i18n-title]').forEach((el) => {
      const key = el.getAttribute('data-i18n-title');
      if (key) el.textContent = fn(key);
    });
    document.querySelectorAll('[data-i18n-teaser]').forEach((el) => {
      const key = el.getAttribute('data-i18n-teaser');
      if (key) el.textContent = fn(key);
    });
  }

  function init() {
    updateMeta();
    updateHomeTexts();
  }
  init();
  window.addEventListener('lang-change', () => {
    updateMeta();
    updateHomeTexts();
  });
</script>
